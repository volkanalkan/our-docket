rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cross-service reads of Firestore from Storage rules need extra IAM
    // wiring beyond what the Firebase Console sets up by default. Given
    // this app only ever has two known users and paths are namespaced by
    // an unguessable coupleId, "signed in" is a pragmatic bar here rather
    // than chasing that IAM setup for a two-person app.
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
